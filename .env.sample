AUTH_SECRET="" # Set to a secure random value. Read more: https://authjs.dev/getting-started/deployment
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`
AUTH_URL='https://forag3r.app/world' # Production; use tunnel URL + /world for local World App testing
NEXT_PUBLIC_BASE_PATH=/world
NEXT_PUBLIC_SITE_URL=https://forag3r.app/world
# World Developer Portal integration URL: https://forag3r.app/world/enter
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the developer portal
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# Forager
NEXT_PUBLIC_PLATFORM_FEE_WALLET='0xYourPlatformFeeWalletAddress' # Platform fee wallet (2% of WLD received)
ALCHEMY_API_KEY='' # World Chain token discovery (alchemy_getTokenBalances). Quotes still work without it via RPC failover.
# Client-safe public RPC only — NEVER put a keyed URL here (it ships to the browser).
NEXT_PUBLIC_WORLDCHAIN_RPC_URL='https://worldchain-mainnet.g.alchemy.com/public'
# Optional server-only failover when Alchemy is down (Uniswap quotes + eth_call balances).
# WORLDCHAIN_QUICKNODE_URL='https://xxx.worldchain-mainnet.quiknode.pro/KEY'
# WORLDCHAIN_TENDERLY_RPC_URL='https://worldchain-mainnet.gateway.tenderly.co'
# WORLDCHAIN_RPC_URLS='https://extra-1.example,https://extra-2.example'

# Leaderboard persistence (optional — falls back to data/forage-events.json locally)
NEXT_PUBLIC_SUPABASE_URL='https://your-project.supabase.co'
SUPABASE_SERVICE_ROLE_KEY='' # Supabase Dashboard → Settings → API → service_role

# Auto-sync forageable tokens → Developer Portal Permit2 / Contract Entrypoints
# Create at developer.world.org → Team → API keys (starts with api_)
# REQUIRED on Vercel Production or scans only queue tokens in Supabase and never push.
WORLD_DEVELOPER_API_KEY=''
# Optional shared secret for POST /api/portal-allowlist
PORTAL_SYNC_SECRET=''
# Optional — Vercel Cron injects this for /api/cron/portal-allowlist
CRON_SECRET=''
